{
  "name": "@muralist/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform ios --platform android",
    "prebuild:android": "CI=1 expo prebuild --platform android --no-install --clean",
    "prebuild:ios": "CI=1 expo prebuild --platform ios --no-install --clean",
    "test": "node ./scripts/validate-mobile-config.mjs",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^5.7.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
